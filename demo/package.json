{
	"name": "monorepo",
	"private": true,
	"workspaces": {
		"packages": [
			"api",
			"ui",
			"host",
			"gateway"
		],
		"catalog": {
			"effect": "3.19.15",
			"zod": "4.3.6",
			"@hot-labs/near-connect": "0.8.2",
			"@libsql/client": "0.17.0",
			"@module-federation/enhanced": "^0.24.1",
			"@module-federation/node": "^2.7.32",
			"@module-federation/rsbuild-plugin": "^0.24.1",
			"@module-federation/runtime-core": "^0.24.1",
			"@radix-ui/react-aspect-ratio": "^1.1.8",
			"@radix-ui/react-avatar": "^1.1.11",
			"@radix-ui/react-checkbox": "^1.3.3",
			"@radix-ui/react-dialog": "^1.1.15",
			"@radix-ui/react-dropdown-menu": "^2.1.16",
			"@radix-ui/react-label": "^2.1.8",
			"@radix-ui/react-navigation-menu": "^1.2.14",
			"@radix-ui/react-radio-group": "^1.3.8",
			"@radix-ui/react-scroll-area": "^1.2.10",
			"@radix-ui/react-select": "^2.2.6",
			"@radix-ui/react-separator": "^1.1.8",
			"@radix-ui/react-slot": "^1.2.4",
			"@radix-ui/react-tabs": "^1.1.13",
			"@tailwindcss/postcss": "^4.1.17",
			"@tanstack/react-query": "5.90.20",
			"@tanstack/react-router": "1.157.16",
			"@tanstack/router-plugin": "^1.139.14",
			"@types/node": "25.0.3",
			"@types/react": "19.2.7",
			"@types/react-dom": "19.2.3",
			"better-auth": "1.4.17",
			"better-near-auth": "0.3.4",
			"drizzle-kit": "0.31.8",
			"drizzle-orm": "0.45.1",
			"near-kit": "0.10.0",
			"react": "19.2.4",
			"react-dom": "19.2.4",
			"tailwindcss": "^4.1.17",
			"typescript": "5.9.3",
			"vitest": "4.0.17",
			"zephyr-rsbuild-plugin": "^0.1.2",
			"zephyr-rspack-plugin": "^0.1.2"
		}
	},
	"dependencies": {
		"@types/bun": "^1.3.6",
		"everything-dev": "link:everything-dev",
		"every-plugin": "link:every-plugin"
	},
	"scripts": {
		"bos": "everything-dev",
		"dev": "bos dev",
		"dev:ui": "bos dev --ui",
		"dev:api": "bos dev --api",
		"dev:host": "bos dev --host",
		"dev:proxy": "bos dev --proxy",
		"build": "bos build",
		"build:api": "bun run --cwd api rsbuild build",
		"build:host": "bun run --cwd host rsbuild build",
		"build:ui": "bun run --cwd ui rsbuild build",
		"deploy": "bos deploy",
		"test": "bos test",
		"typecheck": "bun run --cwd host tsc --noEmit && bun run --cwd ui tsc --noEmit && bun run --cwd api tsc --noEmit",
		"start": "bos start --no-interactive",
		"serve": "bos serve",
		"kill": "bos kill",
		"ps": "bos ps",
		"docker:build": "bos docker build",
		"docker:build:dev": "bos docker build --target development",
		"docker:run": "bos docker run",
		"docker:run:dev": "bos docker run --target development --mode serve",
		"docker:stop": "bos docker stop --all",
		"db:push": "bun run --cwd host drizzle-kit push",
		"db:studio": "bun run --cwd host drizzle-kit studio",
		"db:generate": "bun run --cwd host drizzle-kit generate",
		"db:migrate": "bun run --cwd host drizzle-kit migrate",
		"db:sync": "bun run scripts/sync-db.ts",
		"seed-docs": "bun run scripts/seed-docs.ts"
	},
	"packageManager": "bun@1.3.8"
}
