{
	"name": "host",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --watch dist/server/server.cjs",
		"build": "rsbuild build",
		"build:watch": "rsbuild build --watch",
		"deploy": "DEPLOY=true rsbuild build",
		"bootstrap": "tsx bootstrap.ts",
		"preview": "NODE_ENV=production node dist/server/server.cjs",
		"test": "NODE_ENV=production BOS_CONFIG_PATH=../bos.config.json ./node_modules/.bin/vitest run",
		"test:watch": "NODE_ENV=production BOS_CONFIG_PATH=../bos.config.json ./node_modules/.bin/vitest",
		"typecheck": "tsc --noEmit",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"api": "workspace:*",
		"@hono/node-server": "^1.19.9",
		"@hot-labs/near-connect": "catalog:",
		"@libsql/client": "catalog:",
		"@module-federation/enhanced": "catalog:",
		"@module-federation/node": "catalog:",
		"@module-federation/runtime-core": "catalog:",
		"@orpc/client": "^1.13.4",
		"@orpc/contract": "^1.13.4",
		"@orpc/openapi": "^1.13.4",
		"@orpc/server": "^1.13.4",
		"@orpc/zod": "^1.13.4",
		"@proj-airi/unplugin-drizzle-orm-migrations": "^0.1.4",
		"@t3-oss/env-core": "^0.13.10",
		"@tanstack/react-query": "catalog:",
		"@tanstack/react-router": "catalog:",
		"better-auth": "catalog:",
		"better-near-auth": "catalog:",
		"dotenv": "^17.2.3",
		"drizzle-kit": "catalog:",
		"drizzle-orm": "catalog:",
		"every-plugin": "0.9.0",
		"hono": "^4.11.4",
		"near-kit": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"everything-dev": "link:everything-dev",
